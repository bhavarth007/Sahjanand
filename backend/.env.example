# Copy this file to .env and fill in your values

# JWT
SECRET_KEY=your-strong-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL
# Local: postgresql+asyncpg://user:password@localhost:5432/sahjanand
# Render: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=postgresql+asyncpg://sahjanand:sahjanand@localhost:5432/sahjanand

# Cloudinary (free at cloudinary.com)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# App
APP_NAME=Sahjanand
FRONTEND_URL=http://127.0.0.1:5500
