# Copy this file to .env and fill in your values

# JWT
SECRET_KEY=your-strong-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Supabase Storage (for media uploads)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Cloudinary (optional backup)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# App
APP_NAME=Sahjanand
FRONTEND_URL=http://127.0.0.1:5500
PRODUCTION_URL=https://sahjanand-api.onrender.com

# Firebase Cloud Messaging (for push notifications)
# Get from Firebase Console → Project Settings → Cloud Messaging → Server Key
FCM_SERVER_KEY=your-fcm-server-key
